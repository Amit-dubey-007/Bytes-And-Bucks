# =============================================================================
# MilletMarg Backend - Environment Variables Template
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# =============================================================================

# Django Security
# Generate a strong 50+ character random string in production
SECRET_KEY=your-django-production-secret-key-here
DEBUG=False

# Allowed Hosts (comma-separated domains)
# Render automatically configures RENDER_EXTERNAL_HOSTNAME, but you can also list explicitly:
ALLOWED_HOSTS=your-backend-service.onrender.com,localhost,127.0.0.1

# Production Database (Neon PostgreSQL connection string)
# Example: postgresql://neondb_owner:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-ENDPOINT-pooler.region.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=True

# Local Database Fallback (used only if DATABASE_URL is not set)
DB_NAME=milletmarg
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS & CSRF (comma-separated origins)
# Set to your Vercel production frontend URL (and localhost for testing)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend-service.onrender.com

# SSL / HTTPS Configuration
SECURE_SSL_REDIRECT=False

# Google OAuth 2.0 (Must match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary - Product Image & Receipt Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Store Business Information & WhatsApp
SHOP_NAME="MilletMarg — Healthy Cafe & Millet Store"
SHOP_ADDRESS="Indore, Madhya Pradesh, India"
SHOP_LATITUDE=22.6955176
SHOP_LONGITUDE=75.8333253
OWNER_WHATSAPP_NUMBER=918349309523
FRONTEND_BASE_URL=https://your-frontend.vercel.app

# Delivery Routing (OpenRouteService)
ROUTING_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key
ROUTING_TIMEOUT_SECONDS=5
MAX_DELIVERY_DISTANCE_KM=20.0

# Store Manual Payment Configuration
STORE_UPI_ID=milletmarg@upi
STORE_ACCOUNT_HOLDER="MilletMarg Healthy Cafe"
STORE_BANK_NAME="State Bank of India"
STORE_BANK_ACCOUNT_NO=9876543210123
STORE_BANK_IFSC=SBIN0001234
MAX_RECEIPT_FILE_SIZE_MB=5
