# =============================================================================
# MilletMarg Frontend - Environment Variables Template (Vercel)
# Only public variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# =============================================================================

# Backend API Base URL (Render Web Service URL with /api suffix)
# Example: https://milletmarg-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com/api

# Google OAuth 2.0 Web Client ID
# Must match GOOGLE_CLIENT_ID configured on Render backend
# Example: 1234567890-abcdefg.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
